{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prime Intellect Compute admin-clusters Pods API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pods",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Pods",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.primeintellect.ai/api/v1/pods/",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Pods"
        },
        {
          "info": {
            "name": "Create Pod",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.primeintellect.ai/api/v1/pods/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create Pod"
        },
        {
          "info": {
            "name": "Get Pods History",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.primeintellect.ai/api/v1/pods/history",
            "params": [
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Pods History"
        },
        {
          "info": {
            "name": "Get Pods Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.primeintellect.ai/api/v1/pods/status",
            "params": [
              {
                "name": "pod_ids",
                "value": "",
                "type": "query",
                "description": "List of pod ids"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Pods Status"
        },
        {
          "info": {
            "name": "Get Pod",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.primeintellect.ai/api/v1/pods/:pod_id",
            "params": [
              {
                "name": "pod_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Pod"
        },
        {
          "info": {
            "name": "Delete Pod",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.primeintellect.ai/api/v1/pods/:pod_id",
            "params": [
              {
                "name": "pod_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete Pod"
        },
        {
          "info": {
            "name": "Get Pod Logs Api",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.primeintellect.ai/api/v1/pods/:pod_id/log",
            "params": [
              {
                "name": "pod_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tail",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get logs for a pod.\n\nArgs:\n    tail: Number of most recent logs to return (default: 100)"
        }
      ]
    }
  ],
  "bundled": true
}