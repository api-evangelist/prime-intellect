        {
          "id": "1ecac4ec-1535-41f3-85be-37e2e2b9cd3b",
          "name": "Wallet balance + most recent billing rows",
          "request": {
            "name": "Wallet balance + most recent billing rows",
            "description": {
              "content": "Return the wallet's current balance and most recent billing rows.\n\nAll resource types are included (compute, training, inference, disks,\nsandboxes, images) — same source-of-truth `Billing` table the\ndashboard's Billing History tab reads. Sorted by `lastBilledAt` desc.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "billing",
                "wallet"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Number of recent billing rows to include (max 100)."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Skip this many rows before returning. Lets callers page."
                },
                {
                  "disabled": false,
                  "key": "teamId",
                  "value": "<string>",
                  "description": "If provided, return the team's wallet (requires membership)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
