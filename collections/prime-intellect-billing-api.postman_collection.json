          "id": "90208166-40c8-46c1-b0a9-e86f1ddd04cb",
          "name": "Token usage and cost for a single RFT run",
          "request": {
            "name": "Token usage and cost for a single RFT run",
            "description": {
              "content": "Return the running token + cost totals for one RFT run.\n\nMirrors the per-row training data shown on the billing page (Training\ntokens, Inference input/output tokens, price per million tokens, and\ntotal cost) so an agent can poll this endpoint to monitor a live run.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "billing",
                "runs",
                ":run_id",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "run_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
