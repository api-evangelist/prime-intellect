{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prime Intellect Compute admin-clusters user API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "user",
